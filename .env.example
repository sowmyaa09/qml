# Copy to .env and fill in. Never commit .env.
# Research mapper only — not a medical device.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
