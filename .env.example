# Copy to .env and fill in. Never commit .env.
# Research mapper only — not a medical device.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Chat ids change often (410 / 403 / hang). Muse Glimmer answered this project key.
NVIDIA_MODEL=meta/muse-glimmer-30b
NVIDIA_FALLBACK_MODELS=
# Probe: python scripts/probe_nvidia_models.py
# List: python scripts/ping_nvidia.py list

# Optional: store generated PDF unlock keys (FastAPI server only — never in app.js).
# SQL: supabase/migrations/001_report_unlock_keys.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Unused by this MVP (browser auth later). Keep empty unless you add RLS client reads.
SUPABASE_ANON_KEY=
